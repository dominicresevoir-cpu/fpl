# Required
FPL_TEAM_ID=1234567
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended — enables accurate current squad/bank/free-transfer
# data instead of the public-picks fallback. Only ever sent to FPL's own
# login endpoint. Keep this file out of git.
FPL_EMAIL=
FPL_PASSWORD=

# Optional — enables mini-league-aware recommendations
FPL_LEAGUE_ID=

# Manual fallbacks, only used if FPL_EMAIL/PASSWORD are not set or login fails.
# Update these yourself each week by checking the FPL app.
MANUAL_BANK=0.0
MANUAL_FREE_TRANSFERS=1

# Comma-separated chips you still have available this season.
# Options: wildcard, freehit, bboost, 3xc
CHIPS_AVAILABLE=wildcard,freehit,bboost,3xc

# How many gameweeks ahead to look when scoring fixtures
LOOKAHEAD_GAMEWEEKS=5

# Optional override — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — enables a bookmaker-odds cross-check on fixture difficulty
# alongside FPL's own rating and team-strength data. Free tier (500
# requests/month) at https://the-odds-api.com
ODDS_API_KEY=
